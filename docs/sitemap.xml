---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
        xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {% assign collections = site.collections | where_exp:'collection','collection.output != false' %}
  {% for collection in collections %}
    {% assign docs = collection.docs | where_exp:'doc','doc.sitemap != false' | where_exp:'doc','doc.private_page != true' %}
    {% for doc in docs %}
      {% unless doc.robots contains 'noindex' or doc.redirect_to %}<url>
        <loc>{{ doc.url | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
        {% if doc.last_modified_at or doc.date %}<lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>{% endif %}
        {% if doc.image %}<image:image><image:loc>{{ doc.image | absolute_url | xml_escape }}</image:loc></image:image>{% endif %}
      </url>{% endunless %}
    {% endfor %}
  {% endfor %}

  {% assign pages = site.html_pages | where_exp:'doc','doc.sitemap != false' | where_exp:'doc','doc.url != "/404.html"' | where_exp:'doc','doc.private_page != true' | sort: 'url' %}
  {% for page in pages %}
    {% unless page.robots contains 'noindex' or page.redirect_to %}<url>
      <loc>{{ page.url | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
      {% assign modified = page.date_modified | default: page.last_modified_at %}{% if modified %}<lastmod>{{ modified | date_to_xmlschema }}</lastmod>{% endif %}
      {% if page.image %}<image:image><image:loc>{{ page.image | absolute_url | xml_escape }}</image:loc></image:image>{% endif %}
    </url>{% endunless %}
  {% endfor %}

  {% for product in site.data.product_showcase_pages %}
    <url>
      <loc>{{ product.path | absolute_url | xml_escape }}</loc>
      {% if product.lastModified %}<lastmod>{{ product.lastModified | xml_escape }}</lastmod>{% endif %}
      {% if product.image %}<image:image><image:loc>{{ product.image | xml_escape }}</image:loc></image:image>{% endif %}
    </url>
  {% endfor %}

</urlset>
